  "H2470": { "ko": "아프다, 병들다" },
  "H2490": { "ko": "더럽히다, 시작하다", "note": "할랄 (חָלַל). 동음이의: ①속되게 하다 ②시작하다" },
  "H2491": { "ko": "죽임 당한 자, 찔림 당한 자" },
  "H2502": { "ko": "빼내다, 무장하다" },
  "H2505": { "ko": "나누다, 분배하다" },
  "H2580": { "ko": "은혜, 호의", "note": "헨 (חֵן). 받을 자격 없이 주어지는 호의. '노아가 은혜를 입었더라'" },
  "H2603": { "ko": "은혜를 베풀다, 불쌍히 여기다", "note": "하난 (חָנַן). H2580의 동사형" },
  "H2617": { "ko": "인자, 한결같은 사랑", "note": "헤세드 (חֶסֶד). 언약적 신실함, 변치 않는 사랑. 하나님의 핵심 속성. '자비'보다 '인자'가 더 정확" },
  "H2620": { "ko": "피하다, 의지하다, 피난처를 삼다" },
  "H2654": { "ko": "기뻐하다, 원하다" },
  "H2706": { "ko": "율례, 정한 것" },
  "H2719": { "ko": "칼, 검", "note": "헤레브 (חֶרֶב)" },
  "H2734": { "ko": "노하다, 분노가 타오르다", "note": "하라 (חָרָה). 코가 달아오르다 = 격노하다" },
  "H2803": { "ko": "생각하다, 계획하다, 여기다" },
  "H2822": { "ko": "어둠", "note": "호쉐크 (חֹשֶׁךְ). 창세기 1:2의 어둠. 악/심판의 상징" },
  "H2889": { "ko": "깨끗한, 정결한", "note": "타호르 (טָהוֹר). 의식적 정결" },
  "H2891": { "ko": "정결하게 하다" },
  "H2896": { "ko": "좋은, 선한", "note": "토브 (טוֹב). '하나님이 보시기에 좋았더라'의 '좋은'" },
  "H3001": { "ko": "마르다, 시들다" },
  "H3027": { "ko": "손, 힘", "note": "야드 (יָד). 손 + 권력/능력. '여호와의 손' = 하나님의 권능" },
  "H3034": { "ko": "감사하다, 고백하다", "note": "야다 (יָדָה). 손을 들어 감사/고백. '할렐루야' 찬양의 핵심" },
  "H3045": { "ko": "알다", "note": "야다 (יָדַע). 지적 앎 + 경험적/친밀한 앎. '아담이 하와를 알았더니'" },
  "H3050": { "ko": "야, 여호와(축약형)", "note": "야흐 (יָהּ). YHWH의 축약. 할렐루-야(야를 찬양하라)" },
  "H3068": { "ko": "여호와, 야훼", "note": "YHWH (יְהוָה). 하나님의 고유 이름. '나는 스스로 있는 자'(출 3:14). H1961(하야)에서 파생" },
  "H3069": { "ko": "여호와", "note": "여호비 (יֱהֹוִה). H3068의 변형" },
  "H3072": { "ko": "여호와는 우리의 의", "note": "여호와 치드게누" },
  "H3117": { "ko": "날, 때", "note": "욤 (יוֹם). 하루 + 시대/기간. '여호와의 날'" },
  "H3190": { "ko": "좋게 하다, 잘 하다" },
  "H3205": { "ko": "낳다, 출산하다", "note": "얄라드 (יָלַד). 족보의 핵심 동사" },
  "H3212": { "ko": "가다, 걷다", "note": "얄라크 (יָלַךְ). H1980(할라크)와 유사" },
  "H3220": { "ko": "바다", "note": "얌 (יָם). 지중해 + 서쪽 방향" },
  "H3225": { "ko": "오른쪽, 남쪽", "note": "야민 (יָמִין). 오른손 = 힘과 영예" },
  "H3254": { "ko": "더하다, 다시 하다" },
  "H3290": { "ko": "야곱 (인명)", "note": "발꿈치를 잡다에서 파생. 이스라엘의 다른 이름" },
  "H3318": { "ko": "나가다, 나오다", "note": "야차 (יָצָא). 출애굽의 핵심 동사" },
  "H3320": { "ko": "세우다, 서게 하다" },
  "H3335": { "ko": "빚다, 만들다", "note": "야차르 (יָצַר). 토기장이가 흙을 빚듯 만들다. H1254(바라, 창조)와 구별" },
  "H3372": { "ko": "두려워하다, 경외하다", "note": "야레 (יָרֵא). 공포 + 하나님에 대한 경외. '여호와를 경외함이 지식의 근본'" },
  "H3374": { "ko": "두려움, 경외", "note": "이르아 (יִרְאָה). H3372의 명사형" },
  "H3381": { "ko": "내려가다" },
  "H3384": { "ko": "가르치다, 던지다", "note": "야라 (יָרָה). 토라(율법)의 어근. 화살을 던지듯 방향을 가리킴" },
  "H3389": { "ko": "예루살렘", "note": "평화의 기초/도시" },
  "H3427": { "ko": "앉다, 거주하다", "note": "야샤브 (יָשַׁב). 정착하다, 머물다" },
  "H3444": { "ko": "구원, 해방", "note": "예슈아 (יְשׁוּעָה). 예수(그리스어 이에수스)의 히브리어 어근" },
  "H3467": { "ko": "구원하다, 돕다", "note": "야샤 (יָשַׁע). H3444의 동사형. '호산나' = '구원하소서'의 어근" },
  "H3478": { "ko": "이스라엘", "note": "이스라엘 (יִשְׂרָאֵל). '하나님과 겨루어 이기다'(창 32:28)" },
  "H3513": { "ko": "무겁다, 영화롭게 하다", "note": "카바드 (כָּבַד). 무게 = 중요함 = 영광. H3519(카보드)의 어근" },
  "H3519": { "ko": "영광, 무게", "note": "카보드 (כָּבוֹד). 하나님의 영광, 임재의 무게감" },
  "H3541": { "ko": "이렇게, 이처럼" },
  "H3548": { "ko": "제사장", "note": "코헨 (כֹּהֵן). 하나님과 백성 사이의 중재자" },
  "H3556": { "ko": "별" },
  "H3559": { "ko": "세우다, 준비하다, 확정하다", "note": "쿤 (כּוּן). 견고하게 세우다" },
  "H3581": { "ko": "힘, 능력" },
  "H3588": { "ko": "왜냐하면, ~이므로", "note": "키 (כִּי). 접속사. 이유/원인/조건 등 다양한 용법" },
  "H3605": { "ko": "모든, 전부", "note": "콜 (כֹּל)" },
  "H3607": { "ko": "가두다, 금하다" },
  "H3615": { "ko": "끝내다, 완성하다, 소멸하다" },
  "H3627": { "ko": "그릇, 도구, 무기" },
  "H3651": { "ko": "그러므로, 그렇게" },
  "H3701": { "ko": "은", "note": "케세프 (כֶּסֶף). 은 + 돈" },
  "H3707": { "ko": "분노하게 하다, 노여워하다" },
  "H3722": { "ko": "덮다, 속죄하다", "note": "카파르 (כָּפַר). 죄를 덮다/가리다. 속죄의 핵심 동사. 욤 키푸르(속죄일)의 어근" },
  "H3808": { "ko": "아니다, ~않다" },
  "H3820": { "ko": "마음", "note": "레브 (לֵב). 지성+감정+의지의 중심. 히브리적 '마음'은 감정만이 아니라 사고와 결단을 포함" },
  "H3824": { "ko": "마음", "note": "레바브 (לֵבָב). H3820과 동의어" },
  "H3847": { "ko": "입다" },
  "H3885": { "ko": "머무르다, 유숙하다" },
  "H3899": { "ko": "떡, 빵, 양식", "note": "레헴 (לֶחֶם). 떡 + 음식 전반. 베들레헴 = '떡의 집'" },
  "H3915": { "ko": "밤" },
  "H3925": { "ko": "배우다, 가르치다" },
  "H3947": { "ko": "취하다, 가져가다" },
  "H3966": { "ko": "매우, 심히" },
  "H4057": { "ko": "광야, 들", "note": "미드바르 (מִדְבָּר). H1696(다바르, 말하다)과 관련. 하나님이 말씀하시는 곳" },
  "H4100": { "ko": "무엇, 어찌" },
  "H4150": { "ko": "만남의 장소, 절기, 정한 때", "note": "모에드 (מוֹעֵד). 회막(오헬 모에드) = '만남의 장막'" },
  "H4191": { "ko": "죽다", "note": "무트 (מוּת). '반드시 죽으리라'(창 2:17)" },
  "H4196": { "ko": "제단", "note": "미즈베아흐 (מִזְבֵּחַ). H2076(자바흐, 잡다/제사하다)에서 파생" },
  "H4210": { "ko": "시편, 노래" },
  "H4264": { "ko": "진영, 군대" },
  "H4310": { "ko": "누구" },
  "H4325": { "ko": "물", "note": "마임 (מַיִם). 항상 복수형. 생명+정결+심판의 상징" },
  "H4390": { "ko": "채우다, 가득 차다" },
  "H4397": { "ko": "사자, 천사", "note": "말아크 (מַלְאָךְ). 보내진 자. 인간 전령 + 하나님의 천사" },
  "H4421": { "ko": "전쟁, 전투" },
  "H4427": { "ko": "다스리다, 왕이 되다" },
  "H4428": { "ko": "왕", "note": "멜레크 (מֶלֶךְ)" },
  "H4438": { "ko": "왕국, 나라", "note": "말쿠트 (מַלְכוּת). 왕의 통치 영역" },
  "H4480": { "ko": "~에서부터, ~보다" },
  "H4503": { "ko": "소제, 예물, 선물", "note": "민하 (מִנְחָה). 곡식 제물. 가인과 아벨의 제물" },
  "H4557": { "ko": "수, 숫자" },
  "H4672": { "ko": "찾다, 발견하다" },
  "H4687": { "ko": "계명, 명령", "note": "미츠바 (מִצְוָה). 하나님의 구체적 명령. 율법의 개별 조항" },
  "H4725": { "ko": "장소, 곳" },
  "H4758": { "ko": "모양, 외모, 환상" },
  "H4872": { "ko": "모세 (인명)", "note": "물에서 건져낸 자" },
  "H4941": { "ko": "공의, 판결, 법도", "note": "미쉬파트 (מִשְׁפָּט). 정의로운 판결 + 사회 정의 + 하나님의 법" },
  "H5002": { "ko": "~의 말씀이니라", "note": "네움 (נְאֻם). 선지자의 신탁 도입 공식" },
  "H5046": { "ko": "알리다, 선포하다" },
  "H5060": { "ko": "만지다, 이르다" },
  "H5066": { "ko": "가까이 가다, 나아가다" },
  "H5068": { "ko": "자원하다, 자원예물을 드리다" },
  "H5069": { "ko": "자원하다 (아람어)" },
  "H5071": { "ko": "자원 예물" },
  "H5157": { "ko": "유업을 받다, 상속하다", "note": "나할 (נָחַל). 약속의 땅 분배에 핵심적" },
  "H5159": { "ko": "유업, 기업", "note": "나할라 (נַחֲלָה). 하나님이 주시는 영구적 소유" },
  "H5162": { "ko": "위로하다, 뉘우치다", "note": "나함 (נָחַם). 하나님이 '뉘우치다' = 마음을 돌이키다. 인간적 후회와 다름" },
  "H5186": { "ko": "펴다, 뻗다, 기울이다" },
  "H5221": { "ko": "치다, 때리다" },
  "H5254": { "ko": "시험하다", "note": "나사 (נָסָה). 하나님이 인간을 시험하다(아브라함의 시험)" },
  "H5307": { "ko": "떨어지다, 엎드리다" },
  "H5315": { "ko": "혼, 생명, 목숨", "note": "네페쉬 (נֶפֶשׁ). 숨 쉬는 존재, 전인적 생명. 영혼만이 아니라 전체 인격" },
  "H5329": { "ko": "인도자에게, 지휘자에게", "note": "시편 서두에 자주 등장" },
  "H5337": { "ko": "건지다, 구출하다" },
  "H5341": { "ko": "지키다, 파수하다" },
  "H5375": { "ko": "들어 올리다, 짊어지다, 용서하다", "note": "나사 (נָשָׂא). 짐을 지다 + 죄를 담당하다 + 용서하다. 다의어" },
  "H5414": { "ko": "주다, 놓다", "note": "나탄 (נָתַן). 구약에서 가장 빈출하는 동사 중 하나" },
  "H5437": { "ko": "돌다, 둘러싸다" },
  "H5462": { "ko": "닫다, 가두다" },
  "H5493": { "ko": "돌이키다, 떠나다, 제거하다" },
  "H5509": { "ko": "찌꺼기" },
  "H5521": { "ko": "초막, 장막", "note": "숙카 (סֻכָּה). 초막절(숙콧)의 초막" },
  "H5547": { "ko": "용서, 사면" },
  "H5612": { "ko": "책, 두루마리, 편지" },
  "H5641": { "ko": "숨기다, 감추다" },
  "H5650": { "ko": "종, 하인", "note": "에베드 (עֶבֶד). 하나님의 종 = 높은 호칭. '여호와의 종 모세'" },
  "H5656": { "ko": "섬김, 봉사, 예배" },
  "H5668": { "ko": "~때문에, ~을 위하여" },
  "H5674": { "ko": "건너가다, 지나가다", "note": "아바르 (עָבַר). 히브리(이브리) = '건너편에서 온 자'" },
  "H5704": { "ko": "~까지" },
  "H5706": { "ko": "약탈물, 노획물" },
  "H5707": { "ko": "증인" },
  "H5715": { "ko": "증거" },
  "H5750": { "ko": "아직, 여전히, 다시" },
  "H5769": { "ko": "영원, 옛적", "note": "올람 (עוֹלָם). 시간의 저편. 과거의 영원 + 미래의 영원" },
  "H5771": { "ko": "불의, 죄악, 죄의 형벌", "note": "아본 (עָוֹן). 비뚤어짐, 왜곡. 죄의 내적 본질 + 그 결과" },
  "H5782": { "ko": "깨우다, 일으키다" },
  "H5797": { "ko": "힘, 세력" },
  "H5800": { "ko": "버리다, 떠나다" },
  "H5869": { "ko": "눈", "note": "아인 (עַיִן). 눈 + 샘(물). '여호와의 눈앞에서' = 하나님 보시기에" },
  "H5892": { "ko": "성, 도시", "note": "이르 (עִיר)" },
  "H5921": { "ko": "~위에, ~에 대하여" },
  "H5927": { "ko": "올라가다", "note": "알라 (עָלָה). 번제(올라) = '올라가는 것'. 예루살렘에 '올라가다'" },
  "H5930": { "ko": "번제", "note": "올라 (עֹלָה). 제물 전체를 불태워 하나님께 올리는 제사" },
  "H5945": { "ko": "지극히 높으신 분", "note": "엘리온 (עֶלְיוֹן). 하나님의 호칭. '지극히 높으신 하나님'" },
  "H5971": { "ko": "백성, 민족", "note": "암 (עַם). 하나님의 백성(암 야훼). H1471(고이, 이방 민족)과 구별" },
  "H5973": { "ko": "~와 함께" },
  "H5975": { "ko": "서다, 세우다" },
  "H6030": { "ko": "대답하다, 응답하다", "note": "아나 (עָנָה). 기도에 응답하다" },
  "H6040": { "ko": "고난, 환난" },
  "H6049": { "ko": "점치다" },
  "H6083": { "ko": "먼지, 티끌", "note": "아파르 (עָפָר). '너는 흙이니 흙으로 돌아갈 것이라'(창 3:19)" },
  "H6086": { "ko": "나무", "note": "에츠 (עֵץ). 나무 + 목재. 선악을 알게 하는 나무" },
  "H6213": { "ko": "만들다, 행하다", "note": "아사 (עָשָׂה). H1254(바라, 무에서 창조)와 구별. 기존 재료로 만듦" },
  "H6310": { "ko": "입", "note": "페 (פֶּה). 입 + 가장자리 + 명령" },
  "H6327": { "ko": "흩뜨리다" },
  "H6337": { "ko": "정금, 순금" },
  "H6381": { "ko": "놀라운 일을 행하다", "note": "팔라 (פָּלָא). 기적, 불가사의한 일" },
  "H6437": { "ko": "돌이키다, 향하다" },
  "H6440": { "ko": "얼굴, 앞", "note": "파님 (פָּנִים). 항상 복수형. '하나님의 얼굴' = 하나님의 임재" },
  "H6485": { "ko": "방문하다, 돌보다, 세다", "note": "파카드 (פָּקַד). 관심을 기울이다 + 벌하다 + 임명하다. 다의어" },
  "H6529": { "ko": "열매" },
  "H6565": { "ko": "깨뜨리다, 무효로 하다" },
  "H6588": { "ko": "범법, 반역", "note": "페샤 (פֶּשַׁע). 의도적 반역. H2403(하타, 빗나감)보다 더 심각한 죄" },
  "H6635": { "ko": "군대, 만군", "note": "츠바오트 (צְבָאוֹת). '만군의 여호와' = 천군의 통솔자" },
  "H6662": { "ko": "의로운, 올바른", "note": "차디크 (צַדִּיק). 하나님의 기준에 맞는 자" },
  "H6663": { "ko": "의롭다 하다, 의롭게 되다", "note": "차다크 (צָדַק)" },
  "H6664": { "ko": "의, 공의", "note": "체데크 (צֶדֶק). 올바름, 하나님의 도덕적 기준" },
  "H6666": { "ko": "의, 공의, 바른 행위", "note": "츠다카 (צְדָקָה). H6664와 유사하나 행동적 의로움 강조" },
  "H6680": { "ko": "명령하다" },
  "H6696": { "ko": "에워싸다, 포위하다, 괴롭히다" },
  "H6726": { "ko": "시온", "note": "치욘 (צִיּוֹן). 예루살렘의 별칭. 하나님의 거처" },
  "H6942": { "ko": "거룩하게 하다, 구별하다", "note": "카다쉬 (קָדַשׁ). H6944의 동사형. 속된 것에서 분리하여 하나님께 바침" },
  "H6944": { "ko": "거룩, 거룩한 것", "note": "코데쉬 (קֹדֶשׁ). 하나님께 구별된 것. '거룩하다 거룩하다 거룩하다'" },
  "H6951": { "ko": "회중, 총회" },
  "H6963": { "ko": "목소리, 소리", "note": "콜 (קוֹל). 하나님의 음성, 천둥소리, 사람의 목소리" },
  "H6965": { "ko": "일어나다, 세우다", "note": "쿰 (קוּם). 언약/약속을 세우다" },
  "H7043": { "ko": "가볍게 여기다, 저주하다" },
  "H7069": { "ko": "사다, 얻다, 창조하다" },
  "H7105": { "ko": "수확, 추수" },
  "H7121": { "ko": "부르다, 외치다", "note": "카라 (קָרָא). 이름을 부르다 + 선포하다 + 초청하다" },
  "H7126": { "ko": "가까이 하다, 나아가다", "note": "카라브 (קָרַב). 제사 용어로도 사용: 제물을 드리다" },
  "H7130": { "ko": "가운데, 속" },
  "H7167": { "ko": "찢다" },
  "H7200": { "ko": "보다", "note": "라아 (רָאָה). 물리적 봄 + 이해하다 + 경험하다. '하나님이 보시기에'" },
  "H7218": { "ko": "머리, 꼭대기, 시작", "note": "로쉬 (רֹאשׁ). 머리 + 지도자 + 첫째" },
  "H7225": { "ko": "처음, 시작, 첫 열매", "note": "레쉬트 (רֵאשִׁית). '태초에'(베레쉬트). 시간적 시작 + 최상의 것" },
  "H7227": { "ko": "많은, 큰" },
  "H7235": { "ko": "많아지다, 번성하다" },
  "H7307": { "ko": "바람, 영, 숨", "note": "루아흐 (רוּחַ). 바람+숨+영. 하나님의 영 = 루아흐 엘로힘. 문맥에 따라 의미가 달라짐" },
  "H7311": { "ko": "높이다" },
  "H7321": { "ko": "외치다, 소리 지르다" },
  "H7342": { "ko": "넓은" },
  "H7355": { "ko": "불쌍히 여기다, 긍휼히 여기다", "note": "라함 (רָחַם). 자궁(레헴)에서 파생. 어머니의 사랑 같은 긍휼" },
  "H7356": { "ko": "긍휼, 자비", "note": "라하밈 (רַחֲמִים). H7355의 명사형. 내장이 끓는 듯한 깊은 긍휼" },
  "H7451": { "ko": "악한, 나쁜", "note": "라 (רַע). 도덕적 악 + 재난/불행" },
  "H7453": { "ko": "이웃, 동료" },
  "H7462": { "ko": "먹이다, 목양하다", "note": "라아 (רָעָה). 양을 치다. '여호와는 나의 목자시니'" },
  "H7489": { "ko": "악을 행하다, 해치다" },
  "H7521": { "ko": "기뻐하다, 받으시다" },
  "H7563": { "ko": "악인, 악한 자", "note": "라샤 (רָשָׁע). H6662(차디크, 의인)의 반대" },
  "H7585": { "ko": "스올, 음부", "note": "쉐올 (שְׁאוֹל). 죽은 자들이 가는 곳" },
  "H7604": { "ko": "남다, 남겨지다" },
  "H7607": { "ko": "살, 육체, 친족" },
  "H7611": { "ko": "남은 자", "note": "쉐에리트 (שְׁאֵרִית). 심판 후 살아남은 자들. 소망의 신학" },
  "H7621": { "ko": "맹세" },
  "H7650": { "ko": "맹세하다", "note": "샤바 (שָׁבַע). 일곱(셰바)과 관련. 맹세 = 일곱 번 확인" },
  "H7676": { "ko": "안식일", "note": "샤밧 (שַׁבָּת). H7673(샤바트, 쉬다)에서 파생. 창조 질서의 쉼" },
  "H7725": { "ko": "돌아오다, 돌이키다", "note": "슈브 (שׁוּב). 회개의 핵심 동사. 방향을 바꾸어 하나님께 돌아옴" },
  "H7760": { "ko": "놓다, 두다, 정하다" },
  "H7768": { "ko": "부르짖다, 도움을 청하다" },
  "H7812": { "ko": "엎드리다, 경배하다", "note": "샤하 (שָׁחָה). 몸을 굽혀 절하다. 가장 깊은 예배 행위" },
  "H7843": { "ko": "파괴하다, 부패시키다" },
  "H7860": { "ko": "서기관, 관리" },
  "H7965": { "ko": "평화, 평안, 온전함", "note": "샬롬 (שָׁלוֹם). 단순한 평화가 아니라 완전한 안녕, 번영, 조화. H7999(샬렘)에서 파생" },
  "H7971": { "ko": "보내다", "note": "샬라흐 (שָׁלַח). 사도(보내진 자)의 구약적 개념" },
  "H7999": { "ko": "평안하다, 온전하다, 갚다", "note": "샬렘 (שָׁלֵם). 예루살렘(샬렘)의 어근" },
  "H8034": { "ko": "이름", "note": "쉠 (שֵׁם). 이름 = 본질/성품. '여호와의 이름' = 여호와의 성품" },
  "H8055": { "ko": "기뻐하다, 즐거워하다" },
  "H8064": { "ko": "하늘, 하늘들", "note": "샤마임 (שָׁמַיִם). 항상 복수형. 대기+하나님의 거처" },
  "H8085": { "ko": "듣다, 순종하다", "note": "샤마 (שָׁמַע). 듣다 = 순종하다. '이스라엘아 들으라'(쉐마, 신 6:4)" },
  "H8104": { "ko": "지키다, 보전하다", "note": "샤마르 (שָׁמַר). 에덴동산을 '경작하며 지키라'의 '지키다'" },
  "H8120": { "ko": "섬기다 (아람어)" },
  "H8141": { "ko": "해, 년" },
  "H8147": { "ko": "둘, 양쪽" },
  "H8175": { "ko": "떨다, 폭풍" },
  "H8199": { "ko": "심판하다, 판단하다", "note": "샤파트 (שָׁפַט). 재판하다 + 다스리다 + 구원하다. 사사 = 쇼페트" },
  "H8210": { "ko": "쏟다, 부어 내다" },
  "H8269": { "ko": "지도자, 통치자, 방백" },
  "H8415": { "ko": "깊음, 심연", "note": "테홈 (תְּהוֹם). 창세기 1:2의 '깊음 위에'" },
  "H8432": { "ko": "가운데" },
  "H8451": { "ko": "율법, 가르침, 지침", "note": "토라 (תּוֹרָה). H3384(야라)에서 파생. 단순한 법이 아니라 하나님의 가르침/인도" },
  "H8478": { "ko": "아래, 대신에" },
  "H8549": { "ko": "흠 없는, 온전한", "note": "타밈 (תָּמִים). 제물의 자격: 흠 없음. 노아는 '의롭고 완전한'(타밈) 사람" },
  "H8552": { "ko": "끝나다, 완성되다" },
  "H8605": { "ko": "기도", "note": "테필라 (תְּפִלָּה). H6419(팔랄, 중재하다)에서 파생" },
  "H8615": { "ko": "소망, 기대" },

  "G25": { "ko": "사랑하다 (아가파오)", "note": "ἀγαπάω. 무조건적, 의지적, 자기희생적 사랑. 하나님의 사랑의 본질" },
  "G26": { "ko": "사랑 (아가페)", "note": "ἀγάπη. G25의 명사형. 신약에서 가장 높은 형태의 사랑" },
  "G32": { "ko": "천사, 사자", "note": "앙겔로스 (ἄγγελος). 보내진 자, 전령" },
  "G37": { "ko": "거룩하게 하다" },
  "G40": { "ko": "거룩한", "note": "하기오스 (ἅγιος). 구별된, 하나님께 속한" },
  "G53": { "ko": "거룩한, 순결한" },
  "G71": { "ko": "이끌다, 데려가다" },
  "G80": { "ko": "형제", "note": "아델포스 (ἀδελφός). 혈연 형제 + 영적 형제(신자)" },
  "G86": { "ko": "음부, 하데스", "note": "하데스 (ᾅδης). 죽은 자들의 영역" },
  "G93": { "ko": "불의, 불법" },
  "G94": { "ko": "불의한" },
  "G129": { "ko": "피", "note": "하이마 (αἷμα). 생명 + 속죄 + 언약의 상징. '이것은 내 피니라'" },
  "G154": { "ko": "구하다, 요청하다" },
  "G165": { "ko": "시대, 영원", "note": "아이온 (αἰών). 시대/세대 + 영원. '이 시대'와 '오는 시대'" },
  "G166": { "ko": "영원한", "note": "아이오니오스 (αἰώνιος). 영원한 생명, 영원한 심판" },
  "G189": { "ko": "귀, 들음" },
  "G191": { "ko": "듣다" },
  "G225": { "ko": "진리", "note": "알레테이아 (ἀλήθεια). 숨김없는 것, 실재. 예수: '내가 곧 진리요'" },
  "G227": { "ko": "참된, 진실한" },
  "G228": { "ko": "참된, 진정한" },
  "G240": { "ko": "서로" },
  "G243": { "ko": "다른 (같은 종류의)", "note": "알로스 (ἄλλος). G2087(헤테로스, 다른 종류의)와 구별" },
  "G264": { "ko": "죄를 짓다", "note": "하마르타노 (ἁμαρτάνω). 과녁을 빗나가다" },
  "G266": { "ko": "죄", "note": "하마르티아 (ἁμαρτία). 과녁에서 빗나감. 하나님의 기준에서의 이탈" },
  "G268": { "ko": "죄인" },
  "G281": { "ko": "아멘, 진실로", "note": "아멘 (ἀμήν). H543에서 차용. 예수의 '진실로 진실로' = 아멘 아멘" },
  "G302": { "ko": "(조건절 입자)" },
  "G303": { "ko": "위로, ~마다" },
  "G305": { "ko": "올라가다" },
  "G318": { "ko": "필요, 강제" },
  "G386": { "ko": "부활", "note": "아나스타시스 (ἀνάστασις). 일어남, 부활. 예수의 부활" },
  "G435": { "ko": "남자, 남편", "note": "아네르 (ἀνήρ)" },
  "G444": { "ko": "사람, 인간", "note": "안드로포스 (ἄνθρωπος). 남녀 모두 포함하는 인간" },
  "G450": { "ko": "일어나다, 부활하다" },
  "G473": { "ko": "대신에, ~을 위하여" },
  "G575": { "ko": "~에서부터, ~로부터" },
  "G599": { "ko": "죽다" },
  "G601": { "ko": "나타내다, 계시하다" },
  "G602": { "ko": "계시, 나타남", "note": "아포칼립시스 (ἀποκάλυψις). 베일을 벗김. 요한계시록의 원제" },
  "G622": { "ko": "멸망시키다, 잃어버리다" },
  "G630": { "ko": "놓아주다, 이혼하다" },
  "G649": { "ko": "보내다", "note": "아포스텔로 (ἀποστέλλω). 사도(아포스톨로스)의 어근. 권위를 가지고 파송" },
  "G652": { "ko": "사도", "note": "아포스톨로스 (ἀπόστολος). 보내진 자, 위임받은 대리인" },
  "G680": { "ko": "만지다" },
  "G746": { "ko": "시작, 통치자, 권세", "note": "아르케 (ἀρχή). 태초(요 1:1) + 통치 권력" },
  "G756": { "ko": "시작하다" },
  "G846": { "ko": "그, 그것, 자기" },
  "G853": { "ko": "보이지 않게 하다" },
  "G863": { "ko": "용서하다, 떠나다, 놓아주다", "note": "아피에미 (ἀφίημι). 보내다+떠나게 하다. 죄를 '놓아주다' = 용서" },
  "G907": { "ko": "세례를 주다", "note": "밥티조 (βαπτίζω). 물에 잠기다, 씻다" },
  "G908": { "ko": "세례", "note": "밥티스마 (βάπτισμα)" },
  "G932": { "ko": "나라, 왕국, 통치", "note": "바실레이아 (βασιλεία). '하나님 나라' = 하나님의 통치가 임하는 영역" },
  "G935": { "ko": "왕", "note": "바실류스 (βασιλεύς)" },
  "G976": { "ko": "책, 두루마리" },
  "G1014": { "ko": "원하다, 뜻하다" },
  "G1063": { "ko": "왜냐하면, 곧" },
  "G1080": { "ko": "낳다, 태어나다", "note": "겐나오 (γεννάω). '거듭남'(요 3:3)에 사용" },
  "G1078": { "ko": "출생, 족보" },
  "G1085": { "ko": "족속, 종류" },
  "G1093": { "ko": "땅, 대지" },
  "G1096": { "ko": "되다, 일어나다", "note": "기노마이 (γίνομαι). '말씀이 육신이 되어'(요 1:14)" },
  "G1097": { "ko": "알다", "note": "기노스코 (γινώσκω). 경험적, 관계적 앎" },
  "G1100": { "ko": "혀, 방언", "note": "글로사 (γλῶσσα). 언어 + 방언 은사" },
  "G1108": { "ko": "지식" },
  "G1124": { "ko": "성경, 기록" },
  "G1125": { "ko": "기록하다, 쓰다" },
  "G1135": { "ko": "여자, 아내" },
  "G1161": { "ko": "그러나, 그리고" },
  "G1203": { "ko": "주인" },
  "G1242": { "ko": "언약, 유언", "note": "디아테케 (διαθήκη). 구약의 베리트(H1285)를 번역. 새 언약" },
  "G1247": { "ko": "섬기다, 시중들다", "note": "디아코네오 (διακονέω). 집사(디아코노스)의 어근" },
  "G1249": { "ko": "집사, 봉사자" },
  "G1320": { "ko": "교사, 선생" },
  "G1321": { "ko": "가르치다" },
